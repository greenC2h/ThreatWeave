# DeepSeek 模型服务
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-flash
# 单次模型请求的连接与响应上限（秒），避免 SSE 会话无限等待上游响应。
DEEPSEEK_REQUEST_TIMEOUT_SECONDS=120

# Jev 前置任务分类：用于在主 Agent 执行前判断任务类型、范围和交付意图。
JEVMODEL_API_KEY=
JEVMODEL_BASE_URL=https://jevmodel.org
JEVMODEL_MODEL=jev-latest
JEVMODEL_ENABLED=true
JEVMODEL_TIMEOUT_SECONDS=2

# ModelScope MCP 服务标识
MODELSCOPE_BING_SEARCH_MCP_TOKEN=
MODELSCOPE_CHARTS_MCP_URL=

# PostgreSQL：LangGraph 持久化、认证与 ThreatWeave 业务数据
DB_HOST=localhost
DB_PORT=5432
DB_NAME=langgraph_db
DB_USER=langgraph_user
DB_PASSWORD=
DB_SSLMODE=disable

# 同一文档 running 状态的崩溃恢复租约（秒，最小 60）
THREATWEAVE_PIPELINE_RUNNING_LEASE_SECONDS=7200

# OpenSandbox 服务
OPEN_SANDBOX_API_KEY=

# 定时情报采集调度器；设为 false 时 start_web.py 不启动调度器进程。
THREATWEAVE_SCHEDULER_ENABLED=false
